            RowBox[{"i2G2", ",", " ", "n", ",", " ", "k"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "3", ",", " ", 
            RowBox[{"n", "-", "1"}], ",", " ", "2"}], "}"}]}], "]"}], " ", 
        "\[IndentingNewLine]", "+", " ", 
