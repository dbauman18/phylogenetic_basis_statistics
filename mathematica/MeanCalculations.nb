Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Defining", " ", "all", " ", "of", " ", "the", " ", "relevant", " ", 
    "quantities", " ", "for", " ", "the", " ", "clade", " ", "number", " ", 
    "basis"}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Module", " ", "to", " ", "calculate", " ", "the", " ", "mean", " ", "of",
      " ", "statistic", " ", "represented", " ", "by", " ", "clade"}], "-", 
    RowBox[{"number", " ", "basis", " ", "with", " ", "representation", " ", 
     RowBox[{"f", "[", 
      RowBox[{"n", ",", "r"}], "]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"MeanCladeStatistic", "[", 
    RowBox[{"stat_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sum", ",", "final"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sum", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"stat", "[", 
           RowBox[{"n", ",", "r"}], "]"}], "*", "2", " ", 
          RowBox[{"n", "/", 
           RowBox[{"(", 
            RowBox[{"r", " ", 
             RowBox[{"(", 
              RowBox[{"r", "+", "1"}], ")"}]}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "2", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"final", "=", 
       RowBox[{"sum", "+", 
        RowBox[{"stat", "[", 
         RowBox[{"n", ",", "n"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"final", ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", ">", "3"}], ",", 
           RowBox[{"n", "\[Element]", "Integers"}]}], "}"}]}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
