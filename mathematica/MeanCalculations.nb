          RowBox[{"{", 
           RowBox[{"k", ",", " ", "4", ",", " ", 
            RowBox[{"n", "-", "2"}], ",", " ", "2"}], "}"}]}], "]"}], 
        "\[IndentingNewLine]", "+", " ", 
