Cell[CellGroupData[{

Cell["Balance indices represented by the daughter-number basis", "Subtitle",
 CellChangeTimes->{{3.9627277249881077`*^9, 
  3.9627277312327995`*^9}},ExpressionUUID->"6a9ca887-066d-e546-8b2b-\
54d37460f4f6"],

Cell[TextData[{
 "Finding the mean of balance indices represented by the daughter-number \
basis is a bit trickier. Instead of summing over ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i,j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db040d92-7d57-3a45-965a-b52e80bdb108"],
 ", we will first sum over all pairs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["i", "TI"], ",", 
           StyleBox["j", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(i,j)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd440425-8d7d-6844-afc7-d955ee84827f"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "+", 
         StyleBox["j", "TI"], "\[LongEqual]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i + j = r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73f11ce8-844d-3a47-8f4c-a2a915e6448b"],
 ", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"r", " ", "=", " ", "2"}], ",", " ", "...", ",", " ", "n"}], 
   TraditionalForm]],ExpressionUUID->"bee913e7-07b3-a94f-8136-6500d784830f"],
 ", and then sum those partial sums up. Recall that the mean of a statistic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "(", 
         StyleBox["T", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "B(T)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d8ba3ad0-2d14-2e40-b58a-255a7b0d6042"],
 " which is represented by the daughter-number basis with coefficients ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["n", "TI"]], "(", 
         RowBox[{
           StyleBox["i", "TI"], ",", 
           StyleBox["j", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "b_n(i,j)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3d4f3424-b2eb-b04f-9809-e5b2551ba0aa"],
 " is given by (eqs. 6.2, 6.3)\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["B", "TI"], "(", 
             StyleBox["T", "TI"], ")"}], "]"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{"\[LeftFloor]", 
            RowBox[{
              StyleBox["n", "TI"], "/", "2"}], "\[RightFloor]"}], 
          LimitsPositioning -> True], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", 
            StyleBox["i", "TI"]}], 
          RowBox[{
            StyleBox["n", "TI"], "-", 
            StyleBox["i", "TI"]}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["i", "TI"], ",", 
             StyleBox["j", "TI"]}], ")"}], 
         StyleBox["E", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["D", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], ",", 
                StyleBox["j", "TI"]}]], "(", 
             StyleBox["T", "TI"], ")"}], "]"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["r", "TI"], "\[LongEqual]", "2"}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{"\[LeftFloor]", 
            RowBox[{
              StyleBox["r", "TI"], "/", "2"}], "\[RightFloor]"}], 
          LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["i", "TI"], ",", 
             StyleBox["r", "TI"], "-", 
             StyleBox["i", "TI"]}], ")"}], 
         StyleBox["E", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["D", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], ",", 
                StyleBox["r", "TI"], "-", 
                StyleBox["i", "TI"]}]], "(", 
             StyleBox["T", "TI"], ")"}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "E[B(T)] = \\sum_{i=1}^{\\lfloor n/2 \\rfloor} \\sum_{j=i}^{n-i} \
b_n(i,j) E[D_{i,j}(T)] = \\sum_{r=2}^n \\sum_{i = 1}^{\\lfloor r/2 \\rfloor} \
b_n(i, r-i) E[D_{i, r-i}(T)]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "481066b9-ead2-574e-927c-c3e37668d1ac"],
 "\nThe expected daughter number ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["D", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], ",", 
                StyleBox["j", "TI"]}]], "(", 
             StyleBox["T", "TI"], ")"}], "]"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "+", 
            StyleBox["j", "TI"]}]], 
         RowBox[{"(", 
           StyleBox["i", "TI"], ")"}], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["i", "TI"], "+", 
             StyleBox["j", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "E[D_{i,j}(T)] = p_{i+j}(i) M(n, i+j)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7acf5879-1f06-0542-af6b-ae3cef0cf0f2"],
 " now has two cases, because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["r", "TI"]], 
         RowBox[{"(", 
           StyleBox["i", "TI"], ")"}], "\[LongEqual]", "2", "/", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["r", "TI"], "-", "1"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_r(i) = 2/(r-1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "530654a0-c354-dd4c-927a-5c63e10152c1"],
 " unless ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", 
         StyleBox["r", "TI"], "/", "2"}], TraditionalForm], "errors" -> {}, 
     "input" -> "i = r/2", "state" -> "TeX"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7bbe1479-4142-e547-8922-fb3b692ef239"],
 ", in which case it is equal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "1"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "1 / (n-1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "97158c72-0d72-9441-a037-2e662771c725"],
 ". Therefore, to find the internal sum for a fixed value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d027209c-114d-9448-b4f9-bf65c4ed336a"],
 ", if ",
 Cell[BoxData[
  FormBox["r", TraditionalForm]],ExpressionUUID->
  "015446c8-aed1-9744-90bb-9e843ab48078"],
 " is even it will be equal to \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "0"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["b", "TI"], ";", 
             StyleBox["n", "TI"], ",", 
             StyleBox["r", "TI"]}], "]"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{
            StyleBox["r", "TI"], "/", "2"}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["i", "TI"], ",", 
             StyleBox["r", "TI"], "-", 
             StyleBox["i", "TI"]}], ")"}], 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["r", "TI"]], 
         RowBox[{"(", 
           StyleBox["i", "TI"], ")"}], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["r", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{
            StyleBox["r", "TI"], "-", "1"}]], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["r", "TI"]}], ")"}], 
         RowBox[{"[", 
           RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{
                StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
              RowBox[{
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["r", "TI"], "/", "2"}], ")"}], "-", "1"}], 
              LimitsPositioning -> True], "2", 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["n", "TI"]], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["i", "TI"], ",", 
                 StyleBox["r", "TI"], "-", 
                 StyleBox["i", "TI"]}], ")"}], "+", 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["n", "TI"]], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["r", "TI"], "/", "2", ",", 
                 StyleBox["r", "TI"], "/", "2"}], ")"}]}], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "S_0[b; n,r] =\\sum_{i=1}^{r/2} b_n(i, r-i) p_r(i) M(n,r) \
=\\frac{1}{r-1} M(n,r) \\bigg[ \\sum_{i=1}^{(r/2) - 1} 2 b_n(i, r-i)  + \
b_n(r/2, r/2) \\bigg]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3172d472-dcea-e94d-b7ae-78a27ca5d752"],
 "\nwhile if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3be2d5db-b0df-6f48-80a8-43e56dd558d3"],
 " is odd the internal sum will be equal to \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "1"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["b", "TI"], ";", 
             StyleBox["n", "TI"], ",", 
             StyleBox["r", "TI"]}], "]"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                StyleBox["r", "TI"], "-", "1"}], ")"}], "/", "2"}], 
          LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["i", "TI"], ",", 
             StyleBox["r", "TI"], "-", 
             StyleBox["i", "TI"]}], ")"}], 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["r", "TI"]], 
         RowBox[{"(", 
           StyleBox["i", "TI"], ")"}], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["r", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox["2", 
          RowBox[{
            StyleBox["r", "TI"], "-", "1"}]], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["r", "TI"]}], ")"}], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                StyleBox["r", "TI"], "-", "1"}], ")"}], "/", "2"}], 
          LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["n", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["i", "TI"], ",", 
             StyleBox["r", "TI"], "-", 
             StyleBox["i", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "S_1[b; n,r] = \\sum_{i=1}^{(r-1)/2} b_n(i, r-i) p_r(i) M(n,r) = \
\\frac{2}{r-1} M(n,r) \\sum_{i=1}^{(r-1)/2} b_n(i, r-i)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6fa1fd8-71f0-fa4f-b12b-79d063e420e4"],
 "\nNow, splitting into the cases where ",
 Cell[BoxData[
  FormBox[
