Cell[BoxData[{
 RowBox[{
  RowBox[{"part1EvenN", " ", "[", "n_", "]"}], ":=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"2", 
        RowBox[{"n", " ", "/", 
         RowBox[{"(", 
          RowBox[{"2", "i", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "i"}], "+", "1"}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "i"}], " ", "-", "1"}], ")"}]}], ")"}]}]}], " ", 
       "+", " ", 
       RowBox[{"2", 
        RowBox[{"i", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"n", "-", "i"}], ")"}], 
           RowBox[{"(", 
            RowBox[{"n", "-", "1"}], ")"}]}], ")"}]}]}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "1", ",", " ", 
        RowBox[{
         RowBox[{"n", "/", "2"}], " ", "-", " ", "1"}]}], "}"}]}], " ", "]"}],
     ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", ">", "3"}], ",", 
       RowBox[{"n", "\[Element]", "Integers"}], ",", " ", 
       RowBox[{
        RowBox[{"Mod", "[", 
         RowBox[{"n", ",", "2"}], "]"}], "==", "0"}]}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"result", " ", "=", " ", 
  RowBox[{"part1EvenN", "[", "n", "]"}]}]}], "Input",
