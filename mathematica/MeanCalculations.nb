 FractionBox[
  RowBox[{"2", "-", 
   RowBox[{"6", " ", "n"}], "+", 
   RowBox[{"4", " ", "n", " ", 
    RowBox[{"HarmonicNumber", "[", "n", "]"}]}]}], 
