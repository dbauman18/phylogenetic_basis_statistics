Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Representations", " ", "of", " ", "indices", " ", "represented", " ", 
     "by", " ", "the", " ", "daughter"}], "-", 
    RowBox[{"number", " ", "basis"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"colless", "[", 
      RowBox[{"n_", ",", "i_", ",", "j_"}], "]"}], ":=", " ", 
     RowBox[{"j", "-", "i"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"correctedColless", "[", 
      RowBox[{"n_", ",", "i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"2", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j", "-", "i"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}]}], "/", 
       RowBox[{"(", 
        RowBox[{"n", "-", "2"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"i2", "[", 
      RowBox[{"n_", ",", "i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"j", "-", "i"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"n", "-", "2"}], ")"}], 
             RowBox[{"(", 
              RowBox[{"i", "+", "j", "-", "2"}], ")"}]}], ")"}]}], ",", " ", 
          RowBox[{
           RowBox[{"i", "+", "j"}], " ", ">", " ", "2"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{
           RowBox[{"i", "+", "j"}], " ", "==", " ", "2"}]}], "}"}]}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"totalI", "[", 
      RowBox[{"n_", ",", "i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{
