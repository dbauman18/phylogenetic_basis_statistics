Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Defining", " ", "statistic", " ", "representations", " ", "for", " ", 
     "all", " ", "statistics", " ", "represented", " ", "by", " ", "clade"}], 
    "-", 
    RowBox[{"number", " ", "basis"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sackin", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], " ", ":=", " ", "r"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"averageLeafDepth", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], ":=", " ", 
     RowBox[{"r", "/", "n"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"totalCophenetic", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Binomial", "[", 
           RowBox[{"r", ",", "2"}], "]"}], ",", " ", 
          RowBox[{"r", " ", "<", " ", "n"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"r", " ", "==", " ", "n"}]}], "}"}]}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"sHat", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], " ", ":=", 
     RowBox[{"Log", "[", 
      RowBox[{"r", "-", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"quadraticColless", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], ":=", " ", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "^", "2"}], ",", " ", 
          RowBox[{"r", " ", "<", " ", "n"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"2", "n"}], "-", 
           RowBox[{"n", "^", "2"}]}], ",", " ", 
          RowBox[{"r", "==", "n"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"tIPL", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", ",", " ", 
          RowBox[{"r", "<", "n"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "-", "n"}], ",", " ", 
          RowBox[{"r", " ", "==", " ", "n"}]}], "}"}]}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"tPL", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "r"}], ",", " ", 
          RowBox[{"r", " ", "<", " ", "n"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", 
          RowBox[{"r", "==", "n"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aVD", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"r", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "n"}], "-", "1"}], ")"}]}]}], ",", " ", 
          RowBox[{"r", " ", "<", " ", "n"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "n"}], "-", "1"}], ")"}]}], ",", " ", 
          RowBox[{"r", " ", "==", " ", "n"}]}], "}"}]}], "}"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.960330038693944*^9, 3.960330057731354*^9}, 
