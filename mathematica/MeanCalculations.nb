Cell[CellGroupData[{

Cell["Balance indices represented by the daughter-number basis", "Subtitle",
 CellChangeTimes->{{3.9627277249881077`*^9, 
  3.9627277312327995`*^9}},ExpressionUUID->"6a9ca887-066d-e546-8b2b-\
54d37460f4f6"],

Cell[TextData[{
 "Finding the mean of balance indices represented by the daughter-number \
basis is a bit trickier. Instead of summing over ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i,j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db040d92-7d57-3a45-965a-b52e80bdb108"],
 ", we will first sum over all pairs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["i", "TI"], ",", 
           StyleBox["j", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(i,j)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd440425-8d7d-6844-afc7-d955ee84827f"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "+", 
         StyleBox["j", "TI"], "\[LongEqual]", 
         StyleBox["k", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i + j = k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "73f11ce8-844d-3a47-8f4c-a2a915e6448b"],
 ", for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", "2", ",", "...", ",", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "k = 2, ..., n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bee913e7-07b3-a94f-8136-6500d784830f"],
 ", and then sum those partial sums up. Recall that the mean of a statistic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "(", 
         StyleBox["T", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "A(T)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d8ba3ad0-2d14-2e40-b58a-255a7b0d6042"],
 " which is represented by the daughter-number basis with coefficients ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["a", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], ",", 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "a_{i,j}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3d4f3424-b2eb-b04f-9809-e5b2551ba0aa"],
 " is given by \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["A", "TI"], "(", 
             StyleBox["T", "TI"], ")"}], "]"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{"\[LeftFloor]", 
            RowBox[{
              StyleBox["n", "TI"], "/", "2"}], "\[RightFloor]"}], 
          LimitsPositioning -> True], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", 
            StyleBox["i", "TI"]}], 
          RowBox[{
            StyleBox["n", "TI"], "-", 
            StyleBox["i", "TI"]}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], ",", 
            StyleBox["j", "TI"]}]], 
         StyleBox["E", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["D", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], ",", 
                StyleBox["j", "TI"]}]], "(", 
             StyleBox["T", "TI"], ")"}], "]"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "2"}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{"\[LeftFloor]", 
            RowBox[{
              StyleBox["k", "TI"], "/", "2"}], "\[RightFloor]"}], 
          LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], ",", 
            StyleBox["k", "TI"], "-", 
            StyleBox["i", "TI"]}]], 
         StyleBox["E", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["D", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], ",", 
                StyleBox["k", "TI"], "-", 
                StyleBox["i", "TI"]}]], "(", 
             StyleBox["T", "TI"], ")"}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "E[A(T)] = \\sum_{i=1}^{\\lfloor n/2 \\rfloor} \\sum_{j=i}^{n-i} a_{i,j} \
E[D_{i,j}(T)] = \\sum_{k=2}^n \\sum_{i = 1}^{\\lfloor k/2 \\rfloor} a_{i, \
k-i} E[D_{i, k-i}(T)]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "481066b9-ead2-574e-927c-c3e37668d1ac"],
 "\nThe expected daughter number ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", "TI"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["D", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], ",", 
                StyleBox["j", "TI"]}]], "(", 
             StyleBox["T", "TI"], ")"}], "]"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "+", 
            StyleBox["j", "TI"]}]], 
         RowBox[{"(", 
           StyleBox["i", "TI"], ")"}], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["i", "TI"], "+", 
             StyleBox["j", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "E[D_{i,j}(T)] = p_{i+j}(i) M(n, i+j)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7acf5879-1f06-0542-af6b-ae3cef0cf0f2"],
 " now has two cases, because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["r", "TI"]], 
         RowBox[{"(", 
           StyleBox["i", "TI"], ")"}], "\[LongEqual]", "2", "/", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["r", "TI"], "-", "1"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_r(i) = 2/(r-1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "530654a0-c354-dd4c-927a-5c63e10152c1"],
 " unless ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", 
         StyleBox["r", "TI"], "/", "2"}], TraditionalForm], "errors" -> {}, 
     "input" -> "i = r/2", "state" -> "TeX"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7bbe1479-4142-e547-8922-fb3b692ef239"],
 ", in which case it is equal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "1"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "1 / (n-1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "97158c72-0d72-9441-a037-2e662771c725"],
 ". Therefore, to find the sum for a fixed value of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d027209c-114d-9448-b4f9-bf65c4ed336a"],
 ", if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "015446c8-aed1-9744-90bb-9e843ab48078"],
 " is even it will be equal to \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "0"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["a", "TI"], ";", 
             StyleBox["n", "TI"], ",", 
             StyleBox["k", "TI"]}], "]"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{
            StyleBox["k", "TI"], "/", "2"}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], ",", 
            StyleBox["k", "TI"], "-", 
            StyleBox["i", "TI"]}]], 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           StyleBox["i", "TI"], ")"}], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["k", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{
            StyleBox["k", "TI"], "-", "1"}]], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["k", "TI"]}], ")"}], 
         RowBox[{"[", 
           RowBox[{
             UnderoverscriptBox["\[Sum]", 
              RowBox[{
                StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
              RowBox[{
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["k", "TI"], "/", "2"}], ")"}], "-", "1"}], 
              LimitsPositioning -> True], "2", 
             SubscriptBox[
              StyleBox["a", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], ",", 
                StyleBox["k", "TI"], "-", 
                StyleBox["i", "TI"]}]], "+", 
             SubscriptBox[
              StyleBox["a", "TI"], 
              RowBox[{
                StyleBox["k", "TI"], "/", "2", ",", 
                StyleBox["k", "TI"], "/", "2"}]]}], "]"}]}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "S_0[a; n,k] =\\sum_{i=1}^{k/2} a_{i, k-i} p_k(i) M(n,k) =\\frac{1}{k-1} \
M(n,k) \\bigg[ \\sum_{i=1}^{(k/2) - 1} 2 a_{i,k-i}  + a_{k/2, k/2} \\bigg]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3172d472-dcea-e94d-b7ae-78a27ca5d752"],
 "\nwhile if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3be2d5db-b0df-6f48-80a8-43e56dd558d3"],
 " is odd this will be equal to \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["S", "TI"], "1"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["a", "TI"], ";", 
             StyleBox["n", "TI"], ",", 
             StyleBox["k", "TI"]}], "]"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                StyleBox["k", "TI"], "-", "1"}], ")"}], "/", "2"}], 
          LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], ",", 
            StyleBox["k", "TI"], "-", 
            StyleBox["i", "TI"]}]], 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["k", "TI"]], 
         RowBox[{"(", 
           StyleBox["i", "TI"], ")"}], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["k", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox["2", 
          RowBox[{
            StyleBox["k", "TI"], "-", "1"}]], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["k", "TI"]}], ")"}], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          RowBox[{
            RowBox[{"(", 
              RowBox[{
                StyleBox["k", "TI"], "-", "1"}], ")"}], "/", "2"}], 
          LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], ",", 
            StyleBox["k", "TI"], "-", 
            StyleBox["i", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "S_1[a; n,k] = \\sum_{k=1}^{(k-1)/2} a_{i,k-i}p_k(i) M(n,k) = \
\\frac{2}{k-1} M(n,k) \\sum_{i=1}^{(k-1)/2} a_{i,k-i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6fa1fd8-71f0-fa4f-b12b-79d063e420e4"],
 "\nNow, splitting into the cases where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", "\[LessEqual]", 
         StyleBox["k", "TI"], "<", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "2 \\leq k < n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a450f1e-2582-7247-ac0b-6f6c2b3ce6fb"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["k", "TI"], "\[LongEqual]", 
          StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
      "k = n", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " "}], TraditionalForm]],ExpressionUUID->
  "148c2e56-c2a0-104f-94c3-6a3d4acf2f5f"],
 " and separating into ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c1f42c9-5fd8-6646-bd05-ad8cbacb9bb2"],
 " even and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0a28e0d-bfc8-2d47-b26e-1118cd57a42b"],
 " odd gives us our full expressions for sums, which we do out below. "
}], "Text",
 CellChangeTimes->{{3.9627277435361195`*^9, 3.9627277563466167`*^9}, {
   3.9627277967814045`*^9, 3.962727851073942*^9}, {3.9627278872676296`*^9, 
   3.9627279335475197`*^9}, {3.962728034050127*^9, 3.962728044372696*^9}, {
   3.9627280915924397`*^9, 3.9627281211359234`*^9}, 3.9627281969321995`*^9, {
   3.9627283889195976`*^9, 
   3.962728461630722*^9}},ExpressionUUID->"97a196b1-0c12-8244-bac2-\
3faf4a2ab802"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Function", " ", "to", " ", "solve", " ", "mean", " ", "for", " ", 
     "statistics", " ", "represented", " ", "by", " ", "daughter"}], "-", 
    RowBox[{"number", " ", "basis"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sum", " ", "p_k", 
