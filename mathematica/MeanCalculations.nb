          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"n", ",", " ", "2"}], "]"}], "==", "0"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
