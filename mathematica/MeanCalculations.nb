  3.9604804558990126`*^9}, {3.960565119034525*^9, 3.9605651279732733`*^9}, {
  3.9605651689219656`*^9, 3.9605652097983537`*^9}, {3.9610740132476177`*^9, 
  3.9610741441662827`*^9}},
 CellLabel->
  "In[259]:=",ExpressionUUID->"54940a62-2af7-4b00-88c1-5bdd17993563"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", "-", 
   RowBox[{"6", " ", "n"}], "+", 
   RowBox[{"4", " ", "n", " ", 
    RowBox[{"HarmonicNumber", "[", "n", "]"}]}]}], 
  RowBox[{
   RowBox[{"-", "1"}], "+", 
   RowBox[{"2", " ", "n"}]}]]], "Output",
 CellChangeTimes->{
