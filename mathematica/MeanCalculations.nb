   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i2G2", "[", 
      RowBox[{"n_", ",", "i_", ",", "j_"}], "]"}], ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"j", " ", "-", " ", "i"}], ")"}], " ", "/", " ", 
