Cell[CellGroupData[{

Cell["Average Vertex Depth (A.23)", "Subsection",
 CellChangeTimes->{{4.0021492879937515`*^9, 
  4.0021492936153126`*^9}},ExpressionUUID->"e39218cd-10b4-7c45-bb77-\
22bf854c736d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"aVD", "[", 
    RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", 
         RowBox[{"r", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "n"}], "-", "1"}], ")"}]}]}], ",", " ", 
        RowBox[{"r", " ", "<", " ", "n"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "n"}], "-", "1"}], ")"}]}], ",", " ", 
        RowBox[{"r", " ", "==", " ", "n"}]}], "}"}]}], "}"}], "]"}]}], ";", 
  RowBox[{"meanAVD", " ", "=", " ", 
   RowBox[{"meanCladeStatistic", "[", 
    RowBox[{"aVD", ",", " ", "n"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"DiscretePlot", "[", 
  RowBox[{"meanAVD", ",", " ", 
   RowBox[{"{", 
    RowBox[{"n", ",", " ", "4", ",", " ", "20"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9603299265160456`*^9, 3.9603299348476186`*^9}, {
   3.9603302977474365`*^9, 3.9603303031684165`*^9}, {3.9604775450581813`*^9, 
