   RowBox[{
    RowBox[{
     RowBox[{"meanI2EvenN", "[", "n_", "]"}], ":=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
