Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Function", " ", "to", " ", "solve", " ", "mean", " ", "for", " ", 
     "statistics", " ", "represented", " ", "by", " ", "daughter"}], "-", 
    RowBox[{"number", " ", "basis"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Sum", " ", "p_k", 
       RowBox[{"(", "i", ")"}], " ", "*", " ", 
       RowBox[{"stat", "[", 
        RowBox[{"n", ",", " ", "i", ",", " ", "j"}], "]"}], " ", "over", " ", 
       "a", " ", "level", " ", "set", " ", "i"}], " ", "+", " ", "j"}], " ", "=",
      " ", "k"}], ";", " ", 
    RowBox[{
    "split", " ", "into", " ", "k", " ", "even", " ", "and", " ", "k", " ", 
     "odd"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"partialSumEvenR", "[", 
      RowBox[{"stat_", ",", " ", "n_", ",", " ", "r_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"stat", "[", 
          RowBox[{"n", ",", "i", ",", " ", 
           RowBox[{"r", "-", "i"}]}], "]"}], " ", "*", " ", 
         RowBox[{"2", "/", 
          RowBox[{"(", 
           RowBox[{"r", "-", "1"}], ")"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "1", ",", " ", 
          RowBox[{
           RowBox[{"r", "/", "2"}], " ", "-", " ", "1"}]}], "}"}]}], "]"}], 
      " ", "+", " ", 
      RowBox[{
       RowBox[{"stat", "[", 
        RowBox[{"n", ",", " ", 
         RowBox[{"r", "/", "2"}], ",", " ", 
         RowBox[{"r", "/", "2"}]}], "]"}], " ", "/", 
       RowBox[{"(", 
        RowBox[{"r", "-", "1"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"partialSumOddR", "[", 
      RowBox[{"stat_", ",", " ", "n_", ",", "r_"}], "]"}], ":=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"stat", "[", 
         RowBox[{"n", ",", "i", ",", " ", 
          RowBox[{"r", "-", "i"}]}], "]"}], " ", "*", " ", 
        RowBox[{"2", "/", 
         RowBox[{"(", 
          RowBox[{"r", "-", "1"}], ")"}]}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r", "-", "1"}], ")"}], "/", "2"}]}], " ", "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Now", " ", "sum", " ", "M", 
       RowBox[{"(", 
        RowBox[{"n", ",", "k"}], ")"}], " ", "*", " ", "partial", " ", "Sum", 
       " ", "over", " ", "k"}], "=", "2"}], ",", "...", ",", "n", ",", " ", 
     RowBox[{
      RowBox[{
      "splitting", " ", "into", " ", "even", " ", "and", " ", "odd", " ", "n",
        " ", 
       RowBox[{"cases", ".", " ", "k0"}]}], "=", 
      RowBox[{"2", " ", "is", " ", "the", " ", "default"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"meanStatEvenN", "[", 
      RowBox[{"stat_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"n", "/", 
            RowBox[{"(", 
             RowBox[{"r", 
              RowBox[{"(", 
               RowBox[{"r", "+", "1"}], ")"}]}], ")"}]}], " ", "*", " ", 
           RowBox[{"partialSumEvenR", "[", 
            RowBox[{"stat", ",", " ", "n", ",", "r"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "2", ",", " ", 
            RowBox[{"n", "-", "2"}], ",", " ", "2"}], "}"}]}], "]"}], 
        "\[IndentingNewLine]", "+", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"n", "/", 
            RowBox[{"(", 
             RowBox[{"r", 
              RowBox[{"(", 
               RowBox[{"r", "+", "1"}], ")"}]}], ")"}]}], "*", 
           RowBox[{"partialSumOddR", "[", 
            RowBox[{"stat", ",", " ", "n", ",", " ", "r"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "3", ",", " ", 
            RowBox[{"n", "-", "1"}], ",", " ", "2"}], "}"}]}], "]"}], " ", 
        "\[IndentingNewLine]", "+", " ", 
        RowBox[{"partialSumEvenR", "[", 
         RowBox[{"stat", ",", " ", "n", ",", " ", "n"}], "]"}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", ">", "3"}], ",", 
          RowBox[{"n", "\[Element]", "Integers"}], ",", " ", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"n", ",", " ", "2"}], "]"}], "==", "0"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"meanStatOddN", "[", 
      RowBox[{"stat_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"n", "/", 
            RowBox[{"(", 
             RowBox[{"r", 
              RowBox[{"(", 
               RowBox[{"r", "+", "1"}], ")"}]}], ")"}]}], " ", "*", " ", 
           RowBox[{"partialSumEvenR", "[", 
            RowBox[{"stat", ",", " ", "n", ",", "r"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "2", ",", " ", 
            RowBox[{"n", "-", "1"}], ",", " ", "2"}], "}"}]}], "]"}], 
        "\[IndentingNewLine]", "+", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"n", "/", 
            RowBox[{"(", 
             RowBox[{"r", 
              RowBox[{"(", 
               RowBox[{"r", "+", "1"}], ")"}]}], ")"}]}], "*", 
           RowBox[{"partialSumOddR", "[", 
            RowBox[{"stat", ",", " ", "n", ",", " ", "r"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"r", ",", " ", "3", ",", " ", 
            RowBox[{"n", "-", "2"}], ",", " ", "2"}], "}"}]}], "]"}], " ", 
        "\[IndentingNewLine]", "+", " ", 
        RowBox[{"partialSumOddR", "[", 
         RowBox[{"stat", ",", " ", "n", ",", " ", "n"}], "]"}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", ">", "3"}], ",", 
          RowBox[{"n", "\[Element]", "Integers"}], ",", " ", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"n", ",", " ", "2"}], "]"}], "==", "1"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Aggregate", " ", "into", " ", "a", " ", "final", " ", "function"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Simplify", " ", "in", " ", "a", " ", "way", " ", "that", " ", "chooses", 
     " ", "a", " ", "form", " ", "involving", " ", "HarmonicNumber", " ", 
     "instead", " ", "of", " ", "PolyGamma", " ", "functions"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"simpHarmonic", "=", 
     RowBox[{
      RowBox[{"FullSimplify", "[", 
       RowBox[{"#", ",", 
        RowBox[{"ComplexityFunction", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"LeafCount", "[", "#", "]"}], "+", 
            RowBox[{"100", 
             RowBox[{"Count", "[", 
              RowBox[{"#", ",", "_PolyGamma", ",", "All"}], "]"}]}]}], "&"}], 
          ")"}]}]}], "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"meanDaughterStatistic", "[", 
      RowBox[{"stat_", ",", " ", "n_"}], "]"}], " ", ":=", " ", 
     RowBox[{"simpHarmonic", "[", 
      RowBox[{
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"meanStatEvenN", "[", 
             RowBox[{"stat", ",", " ", "n"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"n", ",", "2"}], "]"}], " ", "==", " ", "0"}]}], "}"}], 
          ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"meanStatOddN", "[", 
             RowBox[{"stat", ",", " ", "n"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Mod", "[", 
              RowBox[{"n", ",", "2"}], "]"}], " ", "==", " ", "1"}]}], 
           "}"}]}], "}"}], "]"}], ",", " ", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", ">", "3"}], ",", 
          RowBox[{"n", "\[Element]", "Integers"}]}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]"}]}]], "Input",
