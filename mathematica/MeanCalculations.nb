      RowBox[{"n_", ",", "r_"}], "]"}], " ", ":=", 
     RowBox[{"Log", "[", 
      RowBox[{"r", "-", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"tIPL", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", ",", " ", 
          RowBox[{"r", "<", "n"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "-", "n"}], ",", " ", 
          RowBox[{"r", " ", "==", " ", "n"}]}], "}"}]}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"tPL", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "r"}], ",", " ", 
          RowBox[{"r", " ", "<", " ", "n"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", 
          RowBox[{"r", "==", "n"}]}], "}"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"aVD", "[", 
      RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
     RowBox[{"Piecewise", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"r", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"2", "n"}], "-", "1"}], ")"}]}]}], ",", " ", 
          RowBox[{"r", " ", "<", " ", "n"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "n"}], "-", "1"}], ")"}]}], ",", " ", 
          RowBox[{"r", " ", "==", " ", "n"}]}], "}"}]}], "}"}], "]"}]}], 
    ";"}]}]}]], "Input",
