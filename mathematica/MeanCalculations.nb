Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "Things", " ", "did", " ", "not", " ", "quite", " ", "work", " ", "for",
        " ", "i2", " ", "mean", " ", "because", " ", "sum", " ", "requires", " ",
        "i"}], " ", "+", " ", "j"}], " ", "=", " ", 
     RowBox[{"k", " ", ">", " ", "2"}]}], ",", " ", 
    RowBox[{"so", " ", "made", " ", "custom", " ", "functions"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"i2G2", "[", 
      RowBox[{"n_", ",", "i_", ",", "j_"}], "]"}], ":=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"j", " ", "-", " ", "i"}], ")"}], " ", "/", " ", 
       RowBox[{"(", 
        RowBox[{"i", " ", "+", " ", "j", " ", "-", " ", "2"}], ")"}]}], " ", "/",
       " ", 
      RowBox[{"(", 
       RowBox[{"n", " ", "-", " ", "2"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"meanI2EvenN", "[", "n_", "]"}], ":=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"n", "/", 
            RowBox[{"(", 
             RowBox[{"k", 
              RowBox[{"(", 
               RowBox[{"k", "+", "1"}], ")"}]}], ")"}]}], " ", "*", " ", 
           RowBox[{"partialSumEvenR", "[", 
            RowBox[{"i2G2", ",", " ", "n", ",", "k"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "4", ",", " ", 
            RowBox[{"n", "-", "2"}], ",", " ", "2"}], "}"}]}], "]"}], 
        "\[IndentingNewLine]", "+", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"n", "/", 
            RowBox[{"(", 
             RowBox[{"k", 
              RowBox[{"(", 
               RowBox[{"k", "+", "1"}], ")"}]}], ")"}]}], "*", 
           RowBox[{"partialSumOddR", "[", 
            RowBox[{"i2G2", ",", " ", "n", ",", " ", "k"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "3", ",", " ", 
            RowBox[{"n", "-", "1"}], ",", " ", "2"}], "}"}]}], "]"}], " ", 
        "\[IndentingNewLine]", "+", " ", 
        RowBox[{"partialSumEvenR", "[", 
         RowBox[{"i2G2", ",", " ", "n", ",", " ", "n"}], "]"}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Assumptions", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", ">", "3"}], ",", 
          RowBox[{"n", "\[Element]", "Integers"}], ",", " ", 
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"n", ",", " ", "2"}], "]"}], "==", "0"}]}], "}"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"meanI2OddN", "[", "n_", "]"}], ":=", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"n", "/", 
            RowBox[{"(", 
             RowBox[{"k", 
              RowBox[{"(", 
               RowBox[{"k", "+", "1"}], ")"}]}], ")"}]}], " ", "*", " ", 
           RowBox[{"partialSumEvenR", "[", 
            RowBox[{"i2G2", ",", " ", "n", ",", "k"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "4", ",", " ", 
            RowBox[{"n", "-", "1"}], ",", " ", "2"}], "}"}]}], "]"}], 
        "\[IndentingNewLine]", "+", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"n", "/", 
            RowBox[{"(", 
             RowBox[{"k", 
              RowBox[{"(", 
               RowBox[{"k", "+", "1"}], ")"}]}], ")"}]}], "*", 
           RowBox[{"partialSumOddR", "[", 
            RowBox[{"i2G2", ",", " ", "n", ",", " ", "k"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"k", ",", " ", "3", ",", " ", 
