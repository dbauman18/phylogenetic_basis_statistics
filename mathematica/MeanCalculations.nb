Notebook[{

Cell[CellGroupData[{
Cell["Expected value of balance indices using basis statistics", "Title",
 CellChangeTimes->{{3.962727162174124*^9, 
  3.96272716969347*^9}},ExpressionUUID->"d8c49b2c-1667-de44-8ca7-\
5227fb76d5a5"],

Cell["Balance indices represented by the clade-number basis", "Subtitle",
 CellChangeTimes->{{3.9627271800216503`*^9, 
  3.9627271867935143`*^9}},ExpressionUUID->"4ef30a81-b300-1c41-91b9-\
9a3f48d2c18a"],

Cell[TextData[{
 "For the eight statistics which are represented by the clade-number basis, \
we can use the given representations (Appendix A) and the following functions \
to simplify the expression for the mean. We are using the formula\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["A", "TI"], "(", 
             StyleBox["T", "TI"], ")"}], "]"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["r", "TI"], "\[LongEqual]", "2"}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["r", "TI"]], 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", 
             StyleBox["r", "TI"]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["n", "TI"]], "+", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["r", "TI"], "\[LongEqual]", "2"}], 
          RowBox[{
            StyleBox["n", "TI"], "-", "1"}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["r", "TI"]], 
         FractionBox[
          RowBox[{"2", 
            StyleBox["n", "TI"]}], 
          RowBox[{
            StyleBox["r", "TI"], "(", 
            RowBox[{
              StyleBox["r", "TI"], "+", "1"}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathbb{E}[A(T)] = \\sum_{r=2}^n a_r M(n,r) = a_n + \\sum_{r=2}^{n-1} \
a_r \\frac{2n}{r(r+1)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3109ec0d-b65d-8e4d-9253-81c878777f61"],
 "\nto find the mean expressions, and a custom function simpHarmonic to try \
to simplify it using HarmonicNumbers instead of functions like PolyGamma. "
}], "Text",
 CellChangeTimes->{{3.962727192408062*^9, 3.962727255258106*^9}, {
  3.9627276445801163`*^9, 3.9627276463714294`*^9}, {3.96272768487105*^9, 
  3.9627277069351616`*^9}},ExpressionUUID->"cd35656c-a9a0-4a41-9c16-\
3ede05a7c7af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Defining", " ", "all", " ", "of", " ", "the", " ", "relevant", " ", 
    "quantities", " ", "for", " ", "the", " ", "clade", " ", "number", " ", 
    "basis"}], " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Module", " ", "to", " ", "calculate", " ", "the", " ", "mean", " ", "of",
      " ", "statistic", " ", "represented", " ", "by", " ", "clade"}], "-", 
    RowBox[{"number", " ", "basis", " ", "with", " ", "representation", " ", 
     RowBox[{"f", "[", 
      RowBox[{"n", ",", "r"}], "]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"MeanCladeStatistic", "[", 
    RowBox[{"stat_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sum", ",", "final"}], "}"}], ",", 
     RowBox[{
      RowBox[{"sum", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"stat", "[", 
           RowBox[{"n", ",", "r"}], "]"}], "*", "2", " ", 
          RowBox[{"n", "/", 
           RowBox[{"(", 
            RowBox[{"r", " ", 
             RowBox[{"(", 
              RowBox[{"r", "+", "1"}], ")"}]}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "2", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"final", "=", 
       RowBox[{"sum", "+", 
        RowBox[{"stat", "[", 
         RowBox[{"n", ",", "n"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"final", ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"n", ">", "3"}], ",", 
           RowBox[{"n", "\[Element]", "Integers"}]}], "}"}]}]}], "]"}]}]}], 
    "]"}]}]}]], "Input",
